<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: call Lago hands-free. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="call"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_call"
        android:shortcutLongLabel="@string/shortcut_call_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lagoagents.mobile"
            android:targetClass="com.lagoagents.mobile.call.CallActivity" />
    </shortcut>
</shortcuts>
